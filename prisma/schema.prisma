generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String           @id @default(cuid())
  username          String           @unique
  email             String?          @unique
  name              String
  passwordHash      String
  roleId            String
  role              Role             @relation(fields: [roleId], references: [id])
  discussionPosts   DiscussionPost[]
  discussionReplies DiscussionReply[]
  announcements     Announcement[]
  notifications     Notification[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum ResourceType {
  NOTE
  STUDY_GUIDE
  PRESENTATION
  REFERENCE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AnnouncementType {
  GENERAL
  ASSIGNMENT
  QUIZ
  EXAM
  LECTURE
  SCHEDULE
  RESOURCE
  OTHER
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  DISCUSSION_REPLY
  RESOURCE
  SCHEDULE
  SYSTEM
}

model Subject {
  id            String           @id @default(cuid())
  name          String
  code          String           @unique
  description   String?
  resources     StudyResource[]
  assignments   Assignment[]
  classSchedule ClassSchedule[]
  discussions   DiscussionPost[]
  announcements Announcement[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model StudyResource {
  id                String       @id @default(cuid())
  title             String
  description       String?
  resourceType      ResourceType
  url               String?
  fileName          String?
  originalFileName  String?
  filePath          String?
  fileMimeType      String?
  fileSize          Int?
  subjectId         String
  subject           Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  fileName    String?
  filePath    String?
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassSchedule {
  id         String   @id @default(cuid())
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String
  instructor String
  room       String
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([subjectId])
}

model DiscussionPost {
  id        String           @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  replies   DiscussionReply[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([subjectId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReply {
  id        String         @id @default(cuid())
  content   String
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model Announcement {
  id        String              @id @default(cuid())
  title     String
  content   String
  type      AnnouncementType
  priority  AnnouncementPriority
  subjectId String?
  subject   Subject?            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([subjectId])
  @@index([authorId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([priority])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model SiteSetting {
  id           String   @id
  founderName  String   @default("Shah Jahan")
  founderImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
